# Variables du backend T03. Définir DATABASE_URL uniquement dans l'environnement local.
# Les secrets Docker T01 sont générés dans infra/.secrets/ par scripts/init_local_env.py.
# Ne pas utiliser ce fichier comme configuration fonctionnelle.
APP_ENV=development
SYNTHETIC_DATA_ONLY=true
DATABASE_URL=
ORTHANC_BASE_URL=
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
AUTH_SECRET=
HL7_SERVICE_SECRET=
# Origine exacte acceptée pour les mutations (schéma, hôte, port).
APP_ORIGIN=http://127.0.0.1:8000
# Budget initial proposé, à ajuster sur mesures
ORTHANC_TIMEOUT_MS=500

